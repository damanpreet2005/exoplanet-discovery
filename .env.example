# Copy to ./.env (git-ignored) next to docker-compose.yml and fill in real
# values. NEVER commit the real .env. Every value below is a placeholder.

# ---- Cloudflare tunnel (production server only; leave empty locally) ----
EXO_TUNNEL_TOKEN=

# ---- MongoDB (user accounts) ----
# Root account: used only by the mongo container to initialise itself. The
# gateway never uses it.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
# Least-privilege account the gateway connects with (created automatically
# by deploy/mongo-init/01-create-app-user.js the first time the data volume
# is initialised -- changing these later requires updating the user in
# MongoDB too).
MONGO_APP_DB=exodiscovery
MONGO_APP_USERNAME=exodiscovery_app
MONGO_APP_PASSWORD=change-me-app-password

# ---- Access-token signing key (Ed25519) ----
# Generate once per environment and keep it stable: changing it signs every
# user out. From Backend/:  npm run generate:jwt-key
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_GENERATED_KEY\n-----END PRIVATE KEY-----
JWT_ISSUER=https://exodiscovery.online
JWT_AUDIENCE=exodiscovery-web
ACCESS_TOKEN_TTL_SECONDS=600

# ---- Cookies / CORS ----
APP_ENV=production
# Keep true in production. Set false only for local http testing in a
# browser that rejects Secure cookies on localhost (e.g. Safari).
COOKIE_SECURE=true
# Trusted browser origins (comma-separated). In production include
# https://exodiscovery.online,https://www.exodiscovery.online
CORS_ALLOW_ORIGINS=http://localhost:5500
