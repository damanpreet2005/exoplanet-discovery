APP_ENV=development
PORT=8000

ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=15
ML_SERVICE_MAX_RETRIES=2
ML_SERVICE_RETRY_BACKOFF_SECONDS=0.5

CSV_MAX_FILE_SIZE_BYTES=5242880

LOG_LEVEL=info

# Comma-separated list of allowed browser origins for the React frontend.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5500

# ---- User accounts: MongoDB ----
# Credentials are separate from the URI (no URL-escaping, and the URI is safe
# to log). For a local `mongod` without auth, leave USERNAME/PASSWORD empty.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=exodiscovery
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=

# ---- User accounts: tokens & sessions ----
# Ed25519 private key, one line with \n escapes: `npm run generate:jwt-key`.
# Alternatively JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_ed25519.pem
JWT_PRIVATE_KEY=
JWT_ISSUER=https://exodiscovery.online
JWT_AUDIENCE=exodiscovery-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000
REFRESH_REUSE_GRACE_SECONDS=10
# Defaults to true when APP_ENV=production.
COOKIE_SECURE=false

# Proxy hops trusted for the client IP used in rate limiting. The default
# trusts only private/loopback addresses (nginx / cloudflared containers).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Rate limits (window in seconds).
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_PER_IP=20
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_ACCOUNT=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_MAX_PER_IP=10
