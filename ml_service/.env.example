APP_ENV=development

# Absolute or relative path to the existing, immutable model artifact.
# Defaults to <repo_root>/model/hybrid_ensemble_model.pkl if unset.
MODEL_PATH=

# Weighted-fusion weights. Must sum to 1.0. No pre-existing weighting scheme
# was found in the repository, so these default to an equal 0.5/0.5 split.
RF_WEIGHT=0.5
CNN_WEIGHT=0.5

MODEL_VERSION=1.0

CACHE_TTL=300
CACHE_MAX_SIZE=512

LOG_LEVEL=INFO

# Comma-separated list of allowed origins. This service should normally only
# be reachable from the main backend, not the browser.
CORS_ALLOW_ORIGINS=*
